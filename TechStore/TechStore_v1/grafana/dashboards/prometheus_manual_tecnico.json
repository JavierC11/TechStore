          "refId": "A"
        }
      ],
      "title": "4️⃣ Latencia P95 del Motor de Consultas PromQL",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Métricas del sistema operativo host recolectadas por Node Exporter (CPU ocupada %).",
      "fieldConfig": {
