# Normalización multiplataforma de saltos de línea (Windows + macOS + Linux/Docker)
* text=auto

# Archivos ejecutados dentro de Linux / contenedores / macOS / WSL -> LF obligatorio
*.sh          text eol=lf
Dockerfile    text eol=lf
.htaccess     text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.py          text eol=lf
*.php         text eol=lf
*.js          text eol=lf
*.css         text eol=lf
*.sql         text eol=lf
*.json        text eol=lf
*.md          text eol=lf
*.Rmd         text eol=lf
*.env*        text eol=lf
*.txt         text eol=lf
.gitignore    text eol=lf
.gitkeep      text eol=lf

# Scripts Batch exclusivos de Windows -> CRLF obligatorio
*.bat         text eol=crlf
*.cmd         text eol=crlf

# Archivos binarios
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.webp        binary
*.pdf         binary
*.pptx        binary
*.xlsx        binary
